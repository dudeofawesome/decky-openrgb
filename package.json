  "bugs": {
    "url": "https://github.com/dudeofawesome/decky-openrgb/issues"
  },
  "homepage": "https://github.com/dudeofawesome/decky-openrgb#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@testing-library/react": "^16.3.2",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "effect": "^3.22.1",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
